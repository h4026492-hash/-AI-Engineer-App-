# ---------------------------------------------------------------------------
# Copy to `.env` and edit. `.env` is gitignored; `.env.example` is committed.
#
# The service boots with zero configuration: with no OPENAI_API_KEY it runs on
# the deterministic offline provider so `make run` and `make test` always work.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=Family MedGuard
APP_ENV=development          # development | staging | production
DEBUG=true
HOST=0.0.0.0                 # 0.0.0.0 is required for Docker + live previews
PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console           # console (human) | json (structured, for prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
REQUEST_TIMEOUT_SECONDS=60

# --- Provider selection ---
# echo   = deterministic, offline, no API key. Extractive answers from retrieved context.
# openai = real calls to the OpenAI API.
LLM_PROVIDER=echo

# --- OpenAI (only needed when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Point at any OpenAI-compatible gateway (Azure OpenAI, LiteLLM, vLLM, Ollama):
OPENAI_BASE_URL=

# --- Retrieval / chunking ---
RAG_CHUNK_SIZE=800           # characters per chunk
RAG_CHUNK_OVERLAP=120        # character overlap between consecutive chunks
RAG_TOP_K=4                  # chunks handed to the model
RAG_MIN_SCORE=0.05           # drop chunks below this cosine similarity
RAG_EMBED_DIM=512            # dimension of the offline hashing embedder

# --- Persistence ---
# Directory for the on-disk vector index. Created on first write.
VECTOR_STORE_PATH=data/vectorstore

# --- Guardrails ---
MAX_INGEST_CHARS=200000      # reject documents larger than this
MAX_QUESTION_CHARS=2000      # reject questions longer than this
RATE_LIMIT_PER_MINUTE=60     # simple in-process limiter; 0 disables
ALLOW_DOCUMENT_MANAGEMENT=false  # keep public demos read-only; no authentication is included
ALLOW_LOCAL_DOCUMENT_OCR=false  # localhost + development only; do not use with real PHI
MAX_LOCAL_OCR_BYTES=8388608     # maximum raw PDF/image size (8 MiB)
